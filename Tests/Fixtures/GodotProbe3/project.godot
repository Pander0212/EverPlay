; EverPlay's own Godot 3 test game (MIT). Packed into a .pck by scripts/godot/make-pck.py.
config_version=4

[application]

config/name="EverPlay Godot 3 Probe"
run/main_scene="res://main.tscn"

[display]

window/size/width=1280
window/size/height=720
window/stretch/mode="2d"
window/stretch/aspect="keep"
